# мейнтейнер 1nfys <lifawafla@gmail.com>
pkgname=atlifm
pkgver=1.0.4
pkgrel=0
pkgdesc="Terminal-style file manager with a GUI mouse-first workflow"
url="https://github.com/1nfys/atlifm"
arch="aarch64 x86_64"
license="MIT"
makedepends="cmake ninja qt6-qtbase-dev qt6-qtsvg-dev"
depends="qt6-qtbase qt6-qtsvg hicolor-icon-theme"
subpackages="$pkgname-doc"
source="atlifm-$pkgver-fixed.tar.gz
	atlifm.metainfo.xml
	atlifm.1"

# контрольная сумма тарбола: обновляется через 'abuild checksum' после
# генерации архива скриптом scripts/make-src-tarball.sh
sha512sums="eba860adc2c7ad54d645a9feeca2e453a36a1df015da92eb1936a714a75cb1d11393a315c013fcc4c86fae716ecfacf193d981f20b9e7bc08136e85de3d48990  atlifm-1.0.4-fixed.tar.gz
c1e5fcc062932821af2d078376eb6e7fa955d85598f86fb781e3f090c07aadbe10fb4e206bba8b395557feb5f3cf591441f7876f8f61b3fd59ceee84ac273acf  atlifm.metainfo.xml
9eb27d0c3488856ef714cdc48ea8f041beb13d2485f17719110659897aff18bb08769c9c9f4f0cc904e5c3ab83a88376198f33f7332bdf368db7ec28e2b5a433  atlifm.1"

build() {
	cmake -S "$srcdir"/$pkgname-$pkgver -B "$srcdir"/build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc
	cmake --build "$srcdir"/build
}

package() {
	DESTDIR="$pkgdir" cmake --install "$srcdir"/build
	install -Dm644 "$srcdir"/atlifm.metainfo.xml \
		"$pkgdir"/usr/share/metainfo/atlifm.metainfo.xml
	install -Dm644 "$srcdir"/atlifm.1 \
		"$pkgdir"/usr/share/man/man1/atlifm.1
}
