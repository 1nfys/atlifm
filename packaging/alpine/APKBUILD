# Мейнтейнер: 1nfys <lifawafla@gmail.com>
pkgname=atlifm
pkgver=1.0.1
pkgrel=0
pkgdesc="Terminal-style file manager with a GUI mouse-first workflow"
url="https://github.com/1nfys/atlifm"
arch="aarch64 x86_64"
license="MIT"
makedepends="cmake ninja qt6-qtbase-dev qt6-qtsvg-dev"
depends="qt6-qtbase qt6-qtsvg hicolor-icon-theme"
subpackages="$pkgname-doc"
source="atlifm-$pkgver-fixed.tar.gz
	atlifm.metainfo.xml
	atlifm.1"

# контрольная сумма тарбола: обновляется через 'abuild checksum' после
# генерации архива скриптом scripts/make-src-tarball.sh
sha512sums="eba860adc2c7ad54d645a9feeca2e453a36a1df015da92eb1936a714a75cb1d11393a315c013fcc4c86fae716ecfacf193d981f20b9e7bc08136e85de3d48990  atlifm-1.0.1-fixed.tar.gz
946c17023fd10dc7aa9e56d89823a8d3ff8c33eecb212453f6dfbe048766e10220313e955d66e536b39101a26771bc6787c817be2e1bbed5a11805e6a327d79a  atlifm.metainfo.xml
edb93c795d1ccfcc836963083a019b0c46b62b506c0325af7f64bd1c186ecfb37f7a04002115dca2a77f1aff278dbdf728877070ca0564a99781df0c178893a4  atlifm.1"

build() {
	cmake -S "$srcdir"/$pkgname-$pkgver -B "$srcdir"/build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc
	cmake --build "$srcdir"/build
}

package() {
	DESTDIR="$pkgdir" cmake --install "$srcdir"/build
	install -Dm644 "$srcdir"/atlifm.metainfo.xml \
		"$pkgdir"/usr/share/metainfo/atlifm.metainfo.xml
	install -Dm644 "$srcdir"/atlifm.1 \
		"$pkgdir"/usr/share/man/man1/atlifm.1
}
