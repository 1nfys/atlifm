# мейнтейнер 1nfys <lifawafla@gmail.com>
pkgname=atlifm
pkgver=1.0.2
pkgrel=0
pkgdesc="Terminal-style file manager with a GUI mouse-first workflow"
url="https://github.com/1nfys/atlifm"
arch="aarch64 x86_64"
license="MIT"
makedepends="cmake ninja qt6-qtbase-dev qt6-qtsvg-dev"
depends="qt6-qtbase qt6-qtsvg hicolor-icon-theme"
subpackages="$pkgname-doc"
source="atlifm-$pkgver-fixed.tar.gz
	atlifm.metainfo.xml
	atlifm.1"

# контрольная сумма тарбола: обновляется через 'abuild checksum' после
# генерации архива скриптом scripts/make-src-tarball.sh
sha512sums="eba860adc2c7ad54d645a9feeca2e453a36a1df015da92eb1936a714a75cb1d11393a315c013fcc4c86fae716ecfacf193d981f20b9e7bc08136e85de3d48990  atlifm-1.0.2-fixed.tar.gz
785b1de2fd2ead0514f8935d4dc4892065b906f865c2b59ca721ffba3848316919b3b6f602aa16cf6ba355a2fa293f722dd6a3819e7b7d747c2ebc9222c9693b  atlifm.metainfo.xml
af7352bc813debc02ac9170fa8fa231d150eec78fc669f37a243a8754b7f6633ea38c218bb443da684c417cd5cdde21f7352eae596b3b41ce1e33d8a99c86f9b  atlifm.1"

build() {
	cmake -S "$srcdir"/$pkgname-$pkgver -B "$srcdir"/build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc
	cmake --build "$srcdir"/build
}

package() {
	DESTDIR="$pkgdir" cmake --install "$srcdir"/build
	install -Dm644 "$srcdir"/atlifm.metainfo.xml \
		"$pkgdir"/usr/share/metainfo/atlifm.metainfo.xml
	install -Dm644 "$srcdir"/atlifm.1 \
		"$pkgdir"/usr/share/man/man1/atlifm.1
}
