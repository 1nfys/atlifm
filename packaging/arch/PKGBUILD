# Мейнтейнер: 1nfys <lifawafla@gmail.com>
pkgname=atlifm
pkgver=1.0.1
pkgrel=1
pkgdesc="Terminal-style file manager with a GUI mouse-first workflow"
arch=('x86_64' 'aarch64')
url="https://github.com/1nfys/atlifm"
license=('MIT')
depends=('qt6-base' 'qt6-svg' 'glib2' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'pkgconf')
optdepends=('libsecret: password management for network places')
source=("atlifm-$pkgver-fixed.tar.gz"
        "atlifm.metainfo.xml"
        "atlifm.1")
sha256sums=('SKIP'
            'cf86a66fa4ab47048545e64e5d472499cd688a8b0390bb0c2e9e3bc189ae6fca'
            'b102975be0e05c391efb4bba4ef2eb9acd660e83373b1cbd861245222d8aaa43')

build() {
	cmake -S "$pkgname-$pkgver" -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build --prefix /usr
	install -Dm644 "$srcdir/atlifm.metainfo.xml" \
		"$pkgdir/usr/share/metainfo/atlifm.metainfo.xml"
	install -Dm644 "$srcdir/atlifm.1" \
		"$pkgdir/usr/share/man/man1/atlifm.1"
}
